{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "downloader",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "workflows": [
    {
      "name": "youtube-downloads",
      "binding": "DOWNLOAD_WORKFLOW",
      "class_name": "DownloadWorkflow"
    }
  ]
}
