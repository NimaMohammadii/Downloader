{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "downloader",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "DownloaderContainer",
      "image": "./Dockerfile",
      "max_instances": 20,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DOWNLOADER_CONTAINER",
        "class_name": "DownloaderContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DownloaderContainer"]
    }
  ],
  "workflows": [
    {
      "name": "youtube-downloads",
      "binding": "DOWNLOAD_WORKFLOW",
      "class_name": "DownloadWorkflow"
    }
  ]
}
