{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "downloader",
  "main": "src/app-main.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ADMIN_STATS",
        "class_name": "AdminStatsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DownloaderContainer"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["DownloaderContainer"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AdminStatsStore"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["YoutubeDownloaderContainer"]
    },
    {
      "tag": "v5",
      "deleted_classes": ["YoutubeDownloaderContainer"]
    }
  ]
}
